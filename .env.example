# URL usada pelos testes E2E. Se omitida, o Playwright inicia o Next localmente.
E2E_BASE_URL=http://127.0.0.1:3100

# Conta exclusiva para testes autenticados. Nunca use uma conta real de cliente.
E2E_COMMERCE_EMAIL=
E2E_COMMERCE_PASSWORD=

# Aplicação e Supabase
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 32 bytes em base64. Use apenas no servidor para cifrar certificados e
# credenciais fiscais; nunca use prefixo NEXT_PUBLIC_ nem reutilize outra chave.
FISCAL_CREDENTIALS_KEY=
ADMIN_EMAILS=

# Assinatura do INCASSA Comércio
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COMERCIO_SAAS=

# Add-ons compartilhados com a política comercial do Restaurante
STRIPE_PRICE_ADDON_MODULOS_RESTAURANTE=
STRIPE_PRICE_ADDON_EQUIPE_RESTAURANTE=
STRIPE_PRICE_ADDON_ABAS_RESTAURANTE=

# Operação, backup e alertas
CRON_SECRET=
HEALTHCHECK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
